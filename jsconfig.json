{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ESNext",
    "checkJs": false,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true
  },
  "include": [
    "**/*.mjs",
    "**/*.js"
  ],
  "exclude": [
    "node_modules",
    "**/node_modules/*"
  ]
}
