    "career-ops:reconcile": "node application/cli.mjs reconcile",
    "test:milestone3a": "node test-milestone3a.mjs",
    "test:milestone3b": "node test-milestone3b.mjs",
    "test:milestone3c": "node test-milestone3c.mjs",
    "test:milestone3d": "node test-milestone3d.mjs",
    "test:milestone3e": "node test-milestone3e.mjs",
    "test:all": "node test-all.mjs --quick && node test-db-phase1.mjs && node test-discovery-milestone2a.mjs && node test-employer-registry-m2b.mjs && node test-crawler-milestone2c.mjs && node test-milestone3a.mjs && node test-milestone3b.mjs && node test-milestone3c.mjs && node test-milestone3d.mjs && node test-milestone3e.mjs && node test-milestone3e-batch-c.mjs && node test-phase4b-legacy-auth.mjs && node test-phase4b-e2e.mjs && node test-phase4c-batch1.mjs && node test-phase4c-batch2.mjs && node test-phase4c-batch2-1.mjs && node test-phase4c-batch3.mjs && node test-phase4c-batch4.mjs",
    "companies:list": "node scripts/manage-companies.mjs list",
    "companies:import": "node scripts/manage-companies.mjs import",
    "companies:verify": "node scripts/manage-companies.mjs verify",
    "companies:coverage": "node scripts/manage-companies.mjs coverage",
    "gemini:eval": "node gemini-eval.mjs"
